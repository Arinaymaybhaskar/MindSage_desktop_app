# Filling the search index. Runs on a fresh install, after an upgrade from the
# Qdrant build, for items saved while Ollama was down, and after a model change.
# Derived from electron/services/indexer.js and electron/db/searchIndex.js.

direction: down

trigger: "Trigger" {
  shape: diamond
  style.stroke-width: 2
}

startup: "App start or\nsearch:bulk-sync" {
  style.stroke-width: 2
}

changed: "Entry saved or edited\nimport · model swap" {
  style.stroke-width: 2
}

work: "pendingWork\npending rows, retries that are due,\nlive items with no index row" {
  style.stroke-width: 2
}

sqlite: "SQLite\nmind-sage.db" {
  shape: cylinder
  style.stroke-width: 2
}

batch: "Batch of 25\npause between batches\nyield 1.5 s after any write" {
  shape: diamond
  style.stroke-width: 2
}

embed: "Embed the item's\ncurrent text" {
  style.stroke-width: 2
}

ollama: "Ollama\nlocalhost:11434" {
  shape: hexagon
  style.stroke-width: 2
}

store: "Store vector\none transaction: item still live\nand text unchanged" {
  style.stroke-width: 2
}

down: "Ollama unavailable\nrows stay pending\nno attempt spent, retry later" {
  style.stroke-width: 2
}

failed: "Item failed\nbackoff 1 min, 5 min, 30 min,\n2 h, 12 h; gives up after 5\nuntil the text changes" {
  style.stroke-width: 2
}

report: "ai-status-event\nindex:bulkProgress to the window" {
  shape: queue
  style.stroke-width: 2
}

done: "Index consistent with the database" {
  shape: oval
  style.stroke-width: 2
}

trigger -> startup
trigger -> changed
startup -> work
changed -> work: "markStale if the\nembedded text changed"
work -> sqlite: "SELECT"
work -> batch
batch -> embed
embed -> ollama: "embed"
embed -> store
store -> sqlite: "vec_entries +\nsearch_index"
embed -> down: "unreachable"
embed -> failed: "error"
down -> work: "later"
failed -> batch: "next item"
store -> batch: "next item"
batch -> report: "progress"
report -> done
