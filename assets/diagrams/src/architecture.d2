# MindSage system architecture
# Render: see assets/diagrams/README.md
#
# Layout note: edges here connect containers, not their children. D2 falls back
# to a horizontal arrangement when an edge crosses into a nested child, which
# turns this diagram into one very wide row.

direction: down

renderer: "Renderer   src/" {
  grid-columns: 2
  style.stroke-width: 2
  style.border-radius: 12

  ui: "React 19 · TypeScript · Tailwind v4\nHashRouter · Context · no Node APIs"
  api: "src/api/*Service.tsx\nthe only way out of the renderer"

  ui -> api
}

main: "Main process   electron/" {
  grid-columns: 4
  style.stroke-width: 2
  style.border-radius: 12

  handlers: "ipcHandlers.js\nchannel routing"
  methods: "methods/*.js\nbusiness logic"
  data: "db/*.js\nSQL · all DDL in connection.js"
  services: "services/\nindexer · Ollama · updater"

  handlers -> methods -> data
}

bus: "eventBus.js\njournal:created · journal:updated · goal:updated · journal:aiCompleted" {
  shape: queue
  style.stroke-width: 2
}

indexer: "services/indexer.js   main process" {
  grid-columns: 3
  style.stroke-width: 2
  style.border-radius: 12

  embed: "Generate embedding"
  store: "Store vector\nre-check item live"
  mark: "Mark search_index ok"

  embed -> store -> mark
}

sqlite: "SQLite\nmind-sage.db" {
  shape: cylinder
  style.stroke-width: 2
}

ollama: "Ollama\nlocalhost:11434" {
  shape: hexagon
  style.stroke-width: 2
}

whisper: "whisper.cpp + FFmpeg\nbundled binaries" {
  shape: hexagon
  style.stroke-width: 2
}

renderer -> main: "ipcRenderer.invoke(channel)\ncontextBridge · preload.cjs"
main -> sqlite: "read / write"
main -> whisper: "transcribe"
main -> ollama: "titles · moods · tags\nsummaries · chat · autocomplete"
main -> bus: "emit"
bus -> indexer: "journal / goal / progress\ncreated · updated"
indexer -> ollama: "embed"
indexer -> sqlite: "vec_entries + search_index\nsame database file"
main -> renderer: "webContents.send\naiStarted / aiCompleted" {
  style.stroke-dash: 4
}
