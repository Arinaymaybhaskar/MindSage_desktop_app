{
  "name": "mindsage-desktop-app",
  "private": true,
  "productName": "MindSage",
  "description": "AI-powered journaling app",
  "author": "Arinaymay arinaymay.bhaskar.7500@gmail.com",
  "version": "1.0.0",
  "type": "module",
  "main": "dist-electron/main.js",
  "homepage": "https://github.com/Arinaymaybhaskar/",
  "scripts": {
    "dev": "vite",
    "build": "vite build && electron-builder",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "postinstall": "npm run rebuild",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "husky"
  },
  "build": {
    "copyright": "Copyright © 2025 Arinaymay",
    "extraResources": [
      {
        "from": "resources/",
        "to": ".",
        "filter": [
          "**/*"
        ]
      }
    ],
    "appId": "com.mindsage.app",
    "productName": "MindSage",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "servers/**/*",
      "src/**/*",
      "public/**/*",
      "electron/workers/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "assets",
      "output": "release"
    },
    "mac": {
      "target": "dmg"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon2.ico"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon2.png"
    }
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.842.0",
    "@aws-sdk/s3-request-presigner": "^3.842.0",
    "@google/genai": "^1.10.0",
    "@qdrant/js-client-rest": "^1.15.1",
    "axios": "^1.10.0",
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^12.2.0",
    "buffer": "^6.0.3",
    "chart.js": "^4.5.0",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.13",
    "dotenv": "^17.2.1",
    "electron-store": "^10.1.0",
    "express": "^5.1.0",
    "ffmpeg-static": "^5.2.0",
    "framer-motion": "^12.23.12",
    "get-port": "^7.1.0",
    "google-auth-library": "^10.1.0",
    "gsap": "^3.13.0",
    "jsonwebtoken": "^9.0.2",
    "lottie-react": "^2.4.1",
    "lucide-react": "^0.525.0",
    "nodemailer": "^7.0.5",
    "pg": "^8.16.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-easy-crop": "^5.5.0",
    "react-hot-toast": "^2.5.2",
    "react-router-dom": "^7.6.3",
    "react-speech-recognition": "^4.0.1",
    "react-textarea-autosize": "^8.5.9",
    "recharts": "^3.0.2",
    "sentiment": "^5.0.2",
    "strip-ansi": "^7.1.0",
    "uuid": "^11.1.0",
    "zip-a-folder": "^3.1.9",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.24.6",
    "zxcvbn": "^4.4.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@tailwindcss/vite": "^4.1.11",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/google.accounts": "^0.0.17",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/react-speech-recognition": "^3.9.6",
    "@types/zxcvbn": "^4.4.5",
    "@vitejs/plugin-react": "^4.6.0",
    "autoprefixer": "^10.4.21",
    "electron": "^37.2.4",
    "electron-builder": "^26.0.12",
    "electron-rebuild": "^3.2.9",
    "eslint": "^9.30.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "nodemon": "^3.1.10",
    "postcss": "^8.5.6",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.1.11",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.35.1",
    "vite": "^7.0.4",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vite-plugin-static-copy": "^3.1.2",
    "vitest": "^4.1.10"
  }
}
