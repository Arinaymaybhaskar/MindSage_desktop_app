# Marketing/demo screenshots. Regenerate with `npm run capture` rather than
# carrying several MB of PNGs in history; nothing in the app loads them. The
# stills README.md embeds are the exception: GitHub renders the README
# straight from the repository, so an untracked screenshot shows up as a
# broken image on the project page. Git never descends into an excluded
# directory, so v2/ is unignored before its contents are filtered.
public/screenshots/*
!public/screenshots/ChatBot.png
!public/screenshots/dashboard.png
!public/screenshots/goalsPage.png
!public/screenshots/journalDetails.png
!public/screenshots/myjournals.png
!public/screenshots/newJournal.png
!public/screenshots/v2/
public/screenshots/v2/*
!public/screenshots/v2/chat.png
!public/screenshots/v2/editor.png
!public/screenshots/v2/goals.png
!public/screenshots/v2/search.png

# Qdrant runtime state, written next to the binary on first start.
resources/win/.qdrant-initialized
resources/win/snapshots/

# Benchmarks: quick (pre-commit) runs are a local trend line, published to the
# website but not committed. Full and partial runs in results/ are committed.
docs/benchmarks/results/quick/
# Benchmark publishing credentials (see .env.bench.example)
.env.bench
